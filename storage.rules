rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // This app manages exactly one building (see SocietyProvider's schema
    // note) — every signed-in user is by definition a member of it, so
    // sign-in is the whole check, matching the equivalent Firestore rule's
    // isMember() gate without needing a cross-service Firestore lookup here.
    match /buildings/main/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // A user's own profile photo — private write, scoped to the owning
    // uid, matching the equivalent Firestore rule for users/{uid}.
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
