rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function phone() {
      return request.auth.token.phone_number;
    }

    // Mirrors Firestore's isMember(). Storage rules can read Firestore
    // directly, which is the only way to answer "is this caller actually in
    // this society?" — and it has to be asked, because many societies now
    // share this bucket. The previous rule accepted any signed-in user for
    // a hardcoded `buildings/main`, which meant one verified phone number
    // could read (and overwrite) every payment screenshot, meter photo and
    // receipt in that society, and meant no other society could upload at
    // all, since nothing matched their path.
    function isMember(buildingId) {
      return isSignedIn() && (
        firestore.exists(/databases/(default)/documents/buildings/$(buildingId)/members/$(request.auth.uid))
        || firestore.get(/databases/(default)/documents/buildings/$(buildingId)).data.adminPhone == phone()
      );
    }

    // Cover photos, expense receipts, meter readings, payment screenshots
    // and issue photos — all scoped to the society they belong to.
    match /buildings/{buildingId}/{allPaths=**} {
      allow read, write: if isMember(buildingId);
    }

    // A user's own profile photo. Nothing in the app resolves another
    // user's photo through Storage — display uses the download URL saved on
    // the Firestore user document — so owner-only access here costs nothing.
    match /users/{uid}/{allPaths=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
